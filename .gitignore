.env
.venv/
**/__pycache__/
*.pyc
.DS_Store
scripts/hosts.json
artifacts/**
!artifacts/.gitkeep
# keep small, hand-written artifacts: model cards and upstream patches.
# (the blanket artifacts/** rule above exists for imatrices, logs and weights)
!artifacts/hf_card_*.md
!artifacts/omlx_patches/
!artifacts/omlx_patches/**
# ANE probe scripts + captured ground truth cited by docs/ANE-M5-MAX.md
!artifacts/ane_probes/
!artifacts/ane_probes/**
calib/**
!calib/.gitkeep
# never commit multi-hundred-GB weights
models/**
!models/.gitkeep
MiniMax-*/
*.safetensors
*.pt
*.bin
# training-run artifacts: checkpoints, downloaded trajectory data, run logs
adapters/**
!adapters/.gitkeep
data/**
!data/.gitkeep
logs/**
!logs/.gitkeep

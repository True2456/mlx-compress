                             # thread". Same root cause and fix as e93c408
                             # for the VLM MTP drafter.
                             materialize_lazy_state(draft_model)
+
+                            # Score on the ANE instead of the GPU when asked.
+                            # The drafter must be 4/5-bit affine gs64/128:
+                            # _affine_spec rejects bf16, in which case
+                            # enable_qwen35_ane_prefill returns 0 and scoring
+                            # stays on GPU without raising.
+                            if getattr(
+                                self._model_settings, "specprefill_ane_enabled", False
+                            ):
+                                try:
+                                    from ..patches.qwen35_ane_prefill import (
+                                        _install_dispatch,
+                                        enable_qwen35_ane_prefill,
+                                    )
+
+                                    _install_dispatch()
+                                    lm_draft = getattr(
+                                        draft_model, "language_model", draft_model
+                                    )
+                                    ane_count = enable_qwen35_ane_prefill(
+                                        lm_draft,
+                                        sequence_length=int(
+                                            getattr(
+                                                self._model_settings,
+                                                "qwen35_ane_prefill_sequence_length",
+                                                4096,
+                                            )
+                                        ),
+                                        fraction=float(
+                                            getattr(
+                                                self._model_settings,
+                                                "qwen35_ane_prefill_fraction",
+                                                0.53,
+                                            )
+                                        ),
+                                        dual_ane=getattr(
+                                            self._model_settings,
+                                            "qwen35_ane_prefill_dual_ane",
+                                            True,
+                                        ),
+                                    )
+                                    if ane_count:
+                                        logger.info(
+                                            "SpecPrefill draft model compiled %d "
+                                            "procedures onto the ANE",
+                                            ane_count,
+                                        )
+                                    else:
+                                        logger.warning(
+                                            "SpecPrefill ANE requested but the drafter "
+                                            "is not eligible (needs 4/5-bit affine "
+                                            "gs64/128); scoring stays on GPU"
+                                        )
+                                except Exception:
+                                    logger.warning(
+                                        "SpecPrefill draft model ANE compilation failed",
+                                        exc_info=True,
+                                    )
                             return draft_model
                         finally:
                             set_mtp_active(was_mtp)

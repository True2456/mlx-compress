From 578ea74fa97e3e0f46a119b7a9071b5e191a7d97 Mon Sep 17 00:00:00 2001
From: True Debreuil <true2456@gmail.com>
Date: Sat, 15 Aug 2026 10:41:30 +1000
Subject: [PATCH] fix(qwen35): skip native qmm routing at group_size=128 on NAX
 hardware

The native prefill qmm only beats nn.QuantizedLinear when it can use the
NAX tensor-unit path, and csrc/qwen35_prefill.cpp gates that on
group_size == 64:

    bool nax = use_nax && group_size == 64 && is_nax_available() && ...

At group_size=128 the call therefore demotes to the plain Metal path, which
measures ~4x slower than the MLX default it replaced. Since 4-bit gs128 is
what mlx_lm.convert and the mlx-community quants produce, affected models
lose roughly half their prefill throughput above the 2048-token routing
threshold, with nothing in the logs to indicate it.

Measured on M5 Max, oMLX 0.6.0.dev1, Qwen3.8-27B (4-bit gs128 MLP),
pp 4096 / tg 128, same binary and model, env var the only difference:

    default (kernel on)   TTFT 7982 ms   ppTPS 513.2
    kernel disabled       TTFT 4429 ms   ppTPS 924.8

Kernel vs MLX at seq 4096, all variants 0-8 tried:

    gate/up gs64    mlx 13.0 ms   kernel 12.9 ms   1.00x
    gate/up gs128   mlx 12.8 ms   kernel 50.7 ms   0.25x
    down    gs64    mlx 14.0 ms   kernel 13.9 ms   1.00x
    down    gs128   mlx 13.8 ms   kernel 51.3 ms   0.27x

Output is numerically correct at both group sizes (rel err 5e-5 at gs128,
bf16 rounding); this is purely a throughput regression.

The skip is limited to hardware where NAX is actually available, so pre-NAX
GPUs keep the existing behaviour, and OMLX_QWEN35_Q4_MLP_ALLOW_GS128=1
restores routing for comparison.
---
 omlx/patches/qwen35_q4_mlp.py | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/omlx/patches/qwen35_q4_mlp.py b/omlx/patches/qwen35_q4_mlp.py
index 5f4add47..1de5a1b2 100644
--- a/omlx/patches/qwen35_q4_mlp.py
+++ b/omlx/patches/qwen35_q4_mlp.py
@@ -51,6 +51,28 @@ def _has_native_qmm() -> bool:
     return _native_qmm_for_bits(4) is not None
 
 
+def _nax_qmm_is_group_size_64_only() -> bool:
+    """True when the NAX (tensor-unit) qmm path is present but gated to gs=64.
+
+    The native kernel only beats ``nn.QuantizedLinear`` when it can use NAX,
+    and the extension gates that on ``group_size == 64``::
+
+        // csrc/qwen35_prefill.cpp
+        bool nax = use_nax && group_size == 64 && is_nax_available() && ...
+
+    So on NAX hardware a group_size=128 call silently demotes to the plain
+    Metal path, which is slower than the MLX default it replaced.
+    """
+    try:
+        from omlx.custom_kernels.qwen35_prefill import fast
+    except Exception:
+        return False
+    try:
+        return bool(fast.is_nax_available()) and bool(fast.nax_qmm_kernels_built())
+    except Exception:
+        return False
+
+
 def _is_supported_affine_linear_shape(
     linear: Any,
     dtype: mx.Dtype,
@@ -69,6 +91,16 @@ def _is_supported_affine_linear_shape(
         return False
     if not _qmm_supports_group_size(int(group_size)):
         return False
+    if (
+        int(group_size) == 128
+        and os.environ.get("OMLX_QWEN35_Q4_MLP_ALLOW_GS128", "0") != "1"
+        and _nax_qmm_is_group_size_64_only()
+    ):
+        # Measured on M5 Max / oMLX 0.6.0.dev1: routing group_size=128 through
+        # the native kernel costs ~4x versus nn.QuantizedLinear, because NAX is
+        # unavailable at that group size. Set OMLX_QWEN35_Q4_MLP_ALLOW_GS128=1
+        # to route anyway.
+        return False
     bits = getattr(linear, "bits", None)
     if bits not in _SUPPORTED_QMM_BITS or getattr(linear, "mode", None) != "affine":
         return False
-- 
